{
  "name": "openclaw-tencent-provider",
  "version": "2026.7.29-1",
  "description": "OpenClaw Tencent Cloud provider plugin (TokenHub + Token Plan)",
  "type": "module",
  "license": "MIT-0",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./api.js": "./dist/api.js",
    "./provider-discovery.js": "./dist/provider-discovery.js",
    "./setup-api.js": "./dist/setup-api.js"
  },
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build",
    "release:dry-run": "scripts/publish.sh",
    "release:clawhub": "scripts/publish.sh --target clawhub --publish",
    "release:npm": "scripts/publish.sh --target npm --publish"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "openclaw": "2026.7.2-beta.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2-beta.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-api.js",
    "install": {
      "clawhubSpec": "clawhub:openclaw-tencent-provider",
      "npmSpec": "openclaw-tencent-provider",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.7.2-beta.5"
    },
    "compat": {
      "pluginApi": ">=2026.7.2-beta.5"
    },
    "build": {
      "openclawVersion": "2026.7.2-beta.5",
      "pluginSdkVersion": "2026.7.2-beta.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tencent/openclaw-tencent-provider.git"
  },
  "homepage": "https://github.com/Tencent/openclaw-tencent-provider#readme",
  "bugs": {
    "url": "https://github.com/Tencent/openclaw-tencent-provider/issues"
  }
}
